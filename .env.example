# -----------------------------------------------------------------------------
# Puma Bot - Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database (Supabase / Neon with PgBouncer Pooling)
# url: Connection pooler port 6543 (transaction mode)
DATABASE_URL="postgresql://postgres.user:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# directUrl: Direct connection port 5432 for migrations
DIRECT_URL="postgresql://postgres.user:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Telegram Integration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_WEBHOOK_SECRET="puma_secret_token_change_in_production_32chars"

# PIX Gateway (PushinPay / Mercado Pago)
PIX_GATEWAY_PROVIDER="PUSHINPAY"
PIX_GATEWAY_TOKEN="pushin_live_token_here"
PIX_GATEWAY_WEBHOOK_SECRET="pix_wh_secret_key_here"

# Security & Cron
CRON_SECRET="puma_cron_token_long_random_alphanumeric_here"
APP_URL="http://localhost:3000"

